# Shell environment template for scripts/processing-live-acceptance.sh.
# This file contains no credential and should not be used to store one.

FG_ACCEPTANCE_BINARY=target/release/file-guardian
FG_ACCEPTANCE_CONFIG=/absolute/path/to/disposable-acceptance.toml

# Required profile contract; see docs/processing-operator-guide.md.
FG_ACCEPTANCE_CLEAN_PROFILE=accept-clean
FG_ACCEPTANCE_BLOCK_PROFILE=accept-block
FG_ACCEPTANCE_HEAD_PROFILE=accept-head
FG_ACCEPTANCE_REACHABLE_PROFILE=accept-reachable
FG_ACCEPTANCE_ALL_REFS_PROFILE=accept-all-refs

# Override only when the acceptance config uses different analyzer IDs.
# FG_ACCEPTANCE_GITLEAKS_ID=gitleaks
# FG_ACCEPTANCE_TRUFFLEHOG_ID=trufflehog

# Optional action and Pi cases. Leave unset to skip.
# FG_ACCEPTANCE_REMEDIATE_PROFILE=accept-remediate
# FG_ACCEPTANCE_PI_ADVISORY_PROFILE=accept-pi-advisory
# FG_ACCEPTANCE_PI_CLEARANCE_PROFILE=accept-pi-clearance

# Optional disposable remotes containing the synthetic history fixture. The
# harness never creates, pushes to, or deletes these remotes.
# FG_ACCEPTANCE_HTTPS_REMOTE=https://example.invalid/disposable/repository.git
# FG_ACCEPTANCE_SSH_REMOTE=git@example.invalid:disposable/repository.git

# Optional absent absolute root. When set, fixtures/results are retained.
# FG_ACCEPTANCE_ROOT=/absolute/private/path/file-guardian-acceptance
# FG_ACCEPTANCE_KEEP=1
